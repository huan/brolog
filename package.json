{
  "name": "brolog",
  "version": "2.0.0",
  "description": "Npmlog like logger for Browser, Node.js, and Deno",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test src tests",
    "test:unit:deno": "deno test --no-check --allow-env src tests",
    "test:pack": "bash -x scripts/npm-pack-testing.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/brolog.git"
  },
  "keywords": [
    "npmlog",
    "log",
    "logger",
    "console.log",
    "browser",
    "deno"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/brolog/issues"
  },
  "homepage": "https://github.com/huan/brolog#readme",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "shx": "^0.3.4"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
